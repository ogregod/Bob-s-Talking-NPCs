{{!-- Shop Window Header - Enhanced with Merchant Portrait --}}
<header class="shop-header-enhanced {{theme}}">
  {{!-- Merchant Portrait --}}
  <div class="merchant-portrait">
    {{#if merchantPortrait}}
      <img src="{{merchantPortrait}}" alt="{{merchantName}}" />
    {{else if shopIcon}}
      <div class="shop-icon-fallback" style="background: {{shopColor}};">
        <i class="fa-solid {{shopIcon}}"></i>
      </div>
    {{else}}
      <img src="icons/svg/mystery-man.svg" alt="Merchant" />
    {{/if}}
    {{#if merchantGreeting}}
      <div class="speech-bubble">{{merchantGreeting}}</div>
    {{/if}}
  </div>

  {{!-- Shop Details --}}
  <div class="shop-details-enhanced">
    <h2 class="shop-name-large">{{shopName}}</h2>
    {{#if merchantName}}
      <span class="merchant-name-subtitle">
        <i class="fa-solid fa-user"></i>
        {{merchantName}}
      </span>
    {{/if}}

    {{!-- Shop Badges --}}
    <div class="shop-badges">
      {{#if priceModifier}}
        {{#if (gt priceModifier 1)}}
          <span class="shop-badge markup" data-tooltip="{{localize 'BOBSNPC.Shop.PriceModifier'}}">
            <i class="fa-solid fa-arrow-up"></i>
            +{{priceModifierPercent}}%
          </span>
        {{else}}
          <span class="shop-badge discount" data-tooltip="{{localize 'BOBSNPC.Shop.PriceModifier'}}">
            <i class="fa-solid fa-arrow-down"></i>
            -{{discountPercent}}%
          </span>
        {{/if}}
      {{/if}}

      {{#if reputationDiscount}}
        <span class="shop-badge reputation" data-tooltip="{{localize 'BOBSNPC.Shop.ReputationDiscount'}}">
          <i class="fa-solid fa-star"></i>
          -{{reputationDiscount}}% Loyalty
        </span>
      {{/if}}

      {{#if hagglingEnabled}}
        <span class="shop-badge haggling" data-tooltip="{{localize 'BOBSNPC.Shop.HagglingAvailable'}}">
          <i class="fa-solid fa-handshake"></i>
          Haggling
        </span>
      {{/if}}
    </div>
  </div>

  {{!-- Player Gold Display --}}
  <div class="player-gold-display">
    <span class="gold-label">Your Gold</span>
    <div class="gold-amount-large">
      <i class="fa-solid fa-coins coin-icon"></i>
      <span class="gold-value">{{playerGold}}</span>
      <span class="gold-denomination">gp</span>
    </div>
    {{#if hasActiveOrders}}
      <button type="button" class="view-orders-btn" data-action="viewOrders" title="{{localize 'BOBSNPC.Service.ViewOrders'}}">
        <i class="fa-solid fa-clipboard-list"></i>
        <span class="order-count">{{activeOrderCount}}</span>
      </button>
    {{/if}}
  </div>
</header>
