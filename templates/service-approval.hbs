{{!-- Service Management Dialog --}}
<div class="service-approval-content {{theme}}">
  {{!-- Tab Navigation --}}
  <div class="tab-navigation">
    <button type="button" class="tab-btn {{#if isPendingTab}}active{{/if}}" data-action="switchTab" data-tab="pending">
      <i class="fa-solid fa-clipboard-list"></i>
      {{localize "BOBSNPC.GM.PendingRequests"}}
      {{#if hasRequests}}
        <span class="tab-badge pending">{{requestCount}}</span>
      {{/if}}
    </button>
    <button type="button" class="tab-btn {{#if isActiveTab}}active{{/if}}" data-action="switchTab" data-tab="active">
      <i class="fa-solid fa-clock"></i>
      {{localize "BOBSNPC.GM.ActiveOrders"}}
      {{#if hasActiveOrders}}
        <span class="tab-badge active">{{activeOrderCount}}</span>
      {{/if}}
    </button>
  </div>

  {{!-- Header with actions --}}
  <div class="approval-header">
    <div class="header-actions">
      <button type="button" class="refresh-btn" data-action="refreshRequests" data-tooltip="Refresh">
        <i class="fa-solid fa-refresh"></i>
      </button>
      {{#if isPendingTab}}
        <button type="button" class="cleanup-btn" data-action="cleanupExpired" data-tooltip="Clean up expired">
          <i class="fa-solid fa-broom"></i>
        </button>
      {{/if}}
    </div>
  </div>

  {{!-- Pending Requests Tab --}}
  {{#if isPendingTab}}
    {{#if hasRequests}}
      <div class="requests-list">
        {{#each requests}}
          <div class="request-card {{this.type}}" data-request-id="{{this.id}}">
            <div class="request-header">
              <div class="service-type">
                <i class="fa-solid {{this.serviceIcon}}"></i>
                <span>{{this.serviceLabel}}</span>
              </div>
              <span class="request-time">{{this.timeAgo}}</span>
            </div>

            <div class="request-body">
              <div class="request-item">
                <img src="{{this.itemImg}}" alt="{{this.itemName}}" class="item-icon">
                <div class="item-details">
                  <span class="item-name">{{this.itemName}}</span>
                  {{#if this.enchantmentName}}
                    <span class="enchantment-name">
                      <i class="fa-solid fa-wand-sparkles"></i>
                      {{this.enchantmentName}}
                    </span>
                  {{/if}}
                </div>
              </div>

              <div class="request-info">
                <div class="info-row">
                  <span class="label">{{localize "BOBSNPC.GM.RequestFrom" player=this.playerName}}</span>
                </div>
                <div class="info-row">
                  <span class="label">{{localize "BOBSNPC.Shop.Merchant"}}:</span>
                  <span class="value">{{this.merchantName}}</span>
                </div>
                <div class="info-row cost">
                  <span class="label">{{localize "BOBSNPC.Chat.Service.Cost"}}:</span>
                  <span class="value">{{this.costFormatted}}</span>
                </div>
              </div>
            </div>

            <div class="request-actions">
              <button type="button" class="approve-btn" data-action="approveRequest" data-request-id="{{this.id}}">
                <i class="fa-solid fa-check"></i>
                {{localize "BOBSNPC.GM.ApproveRequest"}}
              </button>
              <button type="button" class="deny-btn" data-action="denyRequest" data-request-id="{{this.id}}">
                <i class="fa-solid fa-times"></i>
                {{localize "BOBSNPC.GM.DenyRequest"}}
              </button>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="no-requests">
        <i class="fa-solid fa-inbox"></i>
        <p>{{localize "BOBSNPC.GM.NoPendingRequests"}}</p>
      </div>
    {{/if}}
  {{/if}}

  {{!-- Active Orders Tab --}}
  {{#if isActiveTab}}
    {{#if hasActiveOrders}}
      <div class="orders-list">
        {{#each activeOrders}}
          <div class="order-card {{this.statusClass}}" data-order-id="{{this.id}}">
            <div class="order-header">
              <div class="service-type">
                <i class="fa-solid {{this.serviceIcon}}"></i>
                <span>{{this.serviceLabel}}</span>
              </div>
              <span class="order-status {{this.statusClass}}">
                {{#if this.isReady}}
                  <i class="fa-solid fa-check-circle"></i>
                  {{localize "BOBSNPC.Service.Ready"}}
                {{else}}
                  <i class="fa-solid fa-clock"></i>
                  {{this.timeRemainingStr}}
                {{/if}}
              </span>
            </div>

            <div class="order-body">
              <div class="order-item">
                <img src="{{this.itemImg}}" alt="{{this.itemName}}" class="item-icon">
                <div class="item-details">
                  <span class="item-name">{{this.itemName}}</span>
                  {{#if this.enchantmentName}}
                    <span class="enchantment-name">
                      <i class="fa-solid fa-wand-sparkles"></i>
                      {{this.enchantmentName}}
                    </span>
                  {{/if}}
                </div>
              </div>

              <div class="order-info">
                <div class="info-row">
                  <span class="label">{{localize "BOBSNPC.GM.Player"}}:</span>
                  <span class="value">{{this.playerName}}</span>
                </div>
                <div class="info-row">
                  <span class="label">{{localize "BOBSNPC.Shop.Merchant"}}:</span>
                  <span class="value">{{this.merchantName}}</span>
                </div>
                <div class="info-row">
                  <span class="label">{{localize "BOBSNPC.GM.ReadyAt"}}:</span>
                  <span class="value">{{this.readyDateStr}}</span>
                </div>
              </div>
            </div>

            <div class="order-actions">
              {{#unless this.isReady}}
                <button type="button" class="ready-btn" data-action="markReady" data-order-id="{{this.id}}" data-tooltip="{{localize 'BOBSNPC.GM.MarkReady'}}">
                  <i class="fa-solid fa-check-circle"></i>
                  {{localize "BOBSNPC.GM.MarkReady"}}
                </button>
              {{/unless}}
              <button type="button" class="adjust-btn" data-action="adjustTime" data-order-id="{{this.id}}" data-tooltip="{{localize 'BOBSNPC.GM.AdjustTime.Title'}}">
                <i class="fa-solid fa-clock"></i>
              </button>
              <button type="button" class="cancel-btn" data-action="cancelOrder" data-order-id="{{this.id}}" data-tooltip="{{localize 'BOBSNPC.GM.CancelOrder.Title'}}">
                <i class="fa-solid fa-times"></i>
              </button>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="no-orders">
        <i class="fa-solid fa-clipboard-check"></i>
        <p>{{localize "BOBSNPC.GM.NoActiveOrders"}}</p>
      </div>
    {{/if}}
  {{/if}}
</div>
