{{!-- Shop Editor - Services Tab --}}
<div class="tab-content" data-tab-content="services">
  <div class="form-section">
    <h3>{{localize "BOBSNPC.ShopEditor.IdentifyService"}}</h3>

    <div class="form-row">
      <div class="form-group half checkbox">
        <label>
          <input type="checkbox" name="services.identify" {{#if services.identify}}checked{{/if}}>
          {{localize "BOBSNPC.ShopEditor.OfferIdentify"}}
        </label>
      </div>

      <div class="form-group half">
        <label for="identify-price">{{localize "BOBSNPC.ShopEditor.IdentifyPrice"}}</label>
        <div class="input-with-suffix">
          <input type="number" id="identify-price" name="services.identifyPrice" value="{{services.identifyPrice}}" min="0">
          <span class="suffix">gp</span>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3>{{localize "BOBSNPC.ShopEditor.RepairService"}}</h3>

    <div class="form-row">
      <div class="form-group half checkbox">
        <label>
          <input type="checkbox" name="services.repair" {{#if services.repair}}checked{{/if}}>
          {{localize "BOBSNPC.ShopEditor.OfferRepair"}}
        </label>
      </div>

      <div class="form-group half">
        <label for="repair-percent">{{localize "BOBSNPC.ShopEditor.RepairPricePercent"}}</label>
        <div class="input-with-suffix">
          <input type="number" id="repair-percent" name="services.repairPricePercent" value="{{services.repairPricePercent}}" step="0.01" min="0" max="1">
          <span class="suffix">% {{localize "BOBSNPC.ShopEditor.OfItemValue"}}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3>{{localize "BOBSNPC.ShopEditor.AppraiseService"}}</h3>

    <div class="form-row">
      <div class="form-group half checkbox">
        <label>
          <input type="checkbox" name="services.appraise" {{#if services.appraise}}checked{{/if}}>
          {{localize "BOBSNPC.ShopEditor.OfferAppraise"}}
        </label>
      </div>

      <div class="form-group half">
        <label for="appraise-price">{{localize "BOBSNPC.ShopEditor.AppraisePrice"}}</label>
        <div class="input-with-suffix">
          <input type="number" id="appraise-price" name="services.appraisePrice" value="{{services.appraisePrice}}" min="0">
          <span class="suffix">gp</span>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3>{{localize "BOBSNPC.ShopEditor.EnchantService"}}</h3>

    <div class="form-row">
      <div class="form-group half checkbox">
        <label>
          <input type="checkbox" name="services.enchant" {{#if services.enchant}}checked{{/if}}>
          {{localize "BOBSNPC.ShopEditor.OfferEnchant"}}
        </label>
      </div>

      <div class="form-group half">
        <label for="enchant-modifier">{{localize "BOBSNPC.ShopEditor.EnchantPriceModifier"}}</label>
        <div class="input-with-suffix">
          <input type="number" id="enchant-modifier" name="services.enchantmentPriceModifier"
                 value="{{#if services.enchantmentPriceModifier}}{{services.enchantmentPriceModifier}}{{else}}1{{/if}}"
                 step="0.1" min="0.1" max="5">
          <span class="suffix">x</span>
        </div>
      </div>
    </div>

    <p class="hint">{{localize "BOBSNPC.ShopEditor.EnchantHint"}}</p>

    {{#if services.enchant}}
      <div class="enchantment-selection">
        <h4>{{localize "BOBSNPC.Enchantment.AvailableAt"}}</h4>
        {{#if availableEnchantments.length}}
          <div class="enchantment-list">
            {{#each availableEnchantments}}
              <label class="enchantment-option {{#if this.enabled}}enabled{{/if}}">
                <input type="checkbox"
                       name="services.availableEnchantments.{{this.id}}"
                       value="{{this.id}}"
                       {{#if this.enabled}}checked{{/if}}>
                <i class="fa-solid {{this.icon}}"></i>
                <span class="ench-name">{{this.name}}</span>
                <span class="ench-type">({{this.typeLabel}})</span>
                <span class="ench-cost">{{this.baseCost}} gp</span>
              </label>
            {{/each}}
          </div>
        {{else}}
          <p class="no-enchantments">
            {{localize "BOBSNPC.Enchantment.NoEnchantments"}}
            <br>
            <small>Use the Enchantment Manager to add enchantments first.</small>
          </p>
        {{/if}}
      </div>
    {{/if}}
  </div>

  {{!-- Enhanced Services Section --}}
  <div class="form-section enhanced-services-section">
    <div class="section-header">
      <h3>
        <i class="fa-solid fa-concierge-bell"></i>
        Enhanced Services
      </h3>
      <button type="button" class="btn btn-sm" data-action="addService">
        <i class="fa-solid fa-plus"></i>
        Add Service
      </button>
    </div>

    <p class="hint">Configure specialized services this shop offers to customers. These appear in the Services tab of the shop window.</p>

    {{#if hasServicesList}}
      <div class="services-editor-list">
        {{#each servicesList}}
          <div class="service-editor-entry {{#unless this.enabled}}disabled{{/unless}}" data-service-index="{{this.index}}">
            <div class="service-toggle">
              <button type="button"
                      class="toggle-btn {{#if this.enabled}}active{{/if}}"
                      data-action="toggleService"
                      data-service-index="{{this.index}}"
                      data-tooltip="{{#if this.enabled}}Disable{{else}}Enable{{/if}}">
                <i class="fa-solid {{#if this.enabled}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
              </button>
            </div>

            <div class="service-icon-col">
              <i class="fa-solid {{this.icon}}"></i>
            </div>

            <div class="service-info-col">
              <span class="service-name">{{this.name}}</span>
              <span class="service-meta">
                <span class="service-category">{{this.categoryLabel}}</span>
                <span class="service-type-badge">{{this.typeLabel}}</span>
              </span>
              <span class="service-description">{{this.description}}</span>
            </div>

            <div class="service-price-col">
              <span class="service-price">{{this.priceDisplay}}</span>
            </div>

            <div class="service-flags">
              {{#if this.requiresItem}}
                <span class="flag" data-tooltip="Requires an item"><i class="fa-solid fa-box"></i></span>
              {{/if}}
              {{#if this.requiresGMApproval}}
                <span class="flag" data-tooltip="Requires GM approval"><i class="fa-solid fa-shield-halved"></i></span>
              {{/if}}
              {{#if this.hasDuration}}
                <span class="flag" data-tooltip="Takes time"><i class="fa-solid fa-clock"></i></span>
              {{/if}}
            </div>

            <div class="service-actions">
              <button type="button"
                      class="action-btn delete"
                      data-action="removeService"
                      data-service-index="{{this.index}}"
                      data-tooltip="Remove service">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-services">
        <i class="fa-solid fa-concierge-bell"></i>
        <p>No enhanced services configured</p>
        <p class="hint">Click "Add Service" to add services, or they will be auto-populated when you select a shop type template.</p>
      </div>
    {{/if}}
  </div>
</div>
