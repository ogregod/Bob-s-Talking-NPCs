{{!-- Dialogue Editor Canvas --}}
<div class="dialogue-editor-canvas-container {{theme}}">
  <canvas id="dialogue-canvas" class="dialogue-canvas"></canvas>

  {{#unless nodeCount}}
  <div class="canvas-empty-state">
    <i class="fa-solid fa-project-diagram"></i>
    <h4>{{localize "BOBSNPC.DialogueEditor.EmptyCanvasTitle"}}</h4>
    <p>{{localize "BOBSNPC.DialogueEditor.EmptyCanvasHint1"}}</p>
    <p>{{localize "BOBSNPC.DialogueEditor.EmptyCanvasHint2"}}</p>
    <span class="shortcut">{{localize "BOBSNPC.DialogueEditor.EmptyCanvasShortcut"}}</span>
  </div>
  {{/unless}}

  {{#if nodeCount}}
  <div class="canvas-info">
    <span class="node-count">
      <i class="fa-solid fa-project-diagram"></i>
      {{nodeCount}} {{localize "BOBSNPC.DialogueEditor.Nodes"}}
    </span>
  </div>
  {{/if}}

  <div class="canvas-hints">
    <span class="hint">
      <kbd>Scroll</kbd> {{localize "BOBSNPC.DialogueEditor.HintZoom"}}
    </span>
    <span class="hint">
      <kbd>Shift+Drag</kbd> {{localize "BOBSNPC.DialogueEditor.HintPan"}}
    </span>
    <span class="hint">
      <kbd>Double-click</kbd> {{localize "BOBSNPC.DialogueEditor.HintAddNode"}}
    </span>
  </div>
</div>
