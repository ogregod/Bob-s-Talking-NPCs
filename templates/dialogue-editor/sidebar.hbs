{{!-- Dialogue Editor Sidebar --}}
<aside class="dialogue-editor-sidebar {{theme}}">
  <div class="sidebar-resize-handle" data-action="resizeSidebar"></div>
  {{!-- Dialogue Info Section --}}
  <section class="sidebar-section dialogue-info">
    <h3>
      <i class="fa-solid fa-comments"></i>
      {{localize "BOBSNPC.DialogueEditor.DialogueInfo"}}
    </h3>
    <div class="form-group">
      <label>{{localize "BOBSNPC.DialogueEditor.DialogueName"}}</label>
      <input type="text" name="dialogue.name" value="{{dialogue.name}}"
             placeholder="{{localize 'BOBSNPC.DialogueEditor.DialogueNamePlaceholder'}}" />
    </div>
    <div class="form-group">
      <label>{{localize "BOBSNPC.DialogueEditor.DialogueDescription"}}</label>
      <textarea name="dialogue.description" rows="2" placeholder="{{localize 'BOBSNPC.DialogueEditor.DialogueDescriptionPlaceholder'}}">{{dialogue.description}}</textarea>
    </div>
    <div class="dialogue-meta">
      <span class="meta-item" data-tooltip="{{localize 'BOBSNPC.DialogueEditor.DialogueId'}}">
        <i class="fa-solid fa-fingerprint"></i>
        {{truncate dialogue.id 8}}
      </span>
      <span class="meta-item" data-tooltip="{{localize 'BOBSNPC.DialogueEditor.NodeCount'}}">
        <i class="fa-solid fa-project-diagram"></i>
        {{nodeCount}} {{localize "BOBSNPC.DialogueEditor.Nodes"}}
      </span>
    </div>
  </section>

  {{!-- Quick Add Section --}}
  <section class="sidebar-section quick-add">
    <h3>
      <i class="fa-solid fa-plus-circle"></i>
      {{localize "BOBSNPC.DialogueEditor.QuickAdd"}}
    </h3>
    <div class="quick-add-buttons">
      {{#each nodeTypes}}
        <button type="button" class="quick-add-btn" data-action="addNode" data-node-type="{{this.value}}"
                data-tooltip="{{this.label}}">
          <i class="fa-solid {{this.icon}}"></i>
        </button>
      {{/each}}
    </div>
  </section>

  {{!-- Node List --}}
  <section class="sidebar-section node-list">
    <h3>
      <i class="fa-solid fa-list"></i>
      {{localize "BOBSNPC.DialogueEditor.NodeList"}}
      <span class="count">{{nodeCount}}</span>
    </h3>
    <div class="node-list-container">
      {{#each dialogue.nodes}}
        <div class="node-list-item {{#if (eq this.id ../selectedNodeId)}}selected{{/if}} {{#if (eq this.id ../dialogue.startNodeId)}}is-start{{/if}}"
             data-node-id="{{this.id}}">
          <i class="fa-solid {{lookup ../nodeTypeIcons this.type}}"></i>
          <span class="node-label">{{#if this.label}}{{this.label}}{{else}}{{this.type}}{{/if}}</span>
          {{#if (eq this.id ../dialogue.startNodeId)}}
            <span class="start-badge">START</span>
          {{/if}}
        </div>
      {{else}}
        <div class="empty-message">
          {{localize "BOBSNPC.DialogueEditor.NoNodes"}}
        </div>
      {{/each}}
    </div>
  </section>

  {{!-- Selected Node Properties --}}
  {{#if selectedNode}}
  <section class="sidebar-section selected-node">
    <h3>
      <i class="fa-solid {{lookup nodeTypeIcons selectedNode.type}}"></i>
      {{localize "BOBSNPC.DialogueEditor.SelectedNode"}}
      <div class="node-actions">
        <button type="button" class="icon-btn" data-action="editNode" data-tooltip="{{localize 'BOBSNPC.DialogueEditor.EditNode'}}">
          <i class="fa-solid fa-edit"></i>
        </button>
        <button type="button" class="icon-btn danger" data-action="deleteNode" data-tooltip="{{localize 'BOBSNPC.DialogueEditor.DeleteNode'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </h3>

    <div class="node-props">
      <div class="form-group">
        <label>{{localize "BOBSNPC.DialogueEditor.NodeLabel"}}</label>
        <input type="text" name="node.label" value="{{selectedNode.label}}"
               placeholder="{{localize 'BOBSNPC.DialogueEditor.NodeLabelPlaceholder'}}" />
      </div>

      {{!-- Type-specific content preview --}}
      {{#if (eq selectedNode.type "npc_speech")}}
        <div class="form-group">
          <label>{{localize "BOBSNPC.DialogueEditor.SpeechText"}}</label>
          <textarea name="node.text" rows="3">{{selectedNode.text}}</textarea>
        </div>
        <div class="node-stat">
          <i class="fa-solid fa-reply"></i>
          {{selectedNode.responses.length}} {{localize "BOBSNPC.DialogueEditor.Responses"}}
        </div>
      {{/if}}

      {{#if (eq selectedNode.type "player_choice")}}
        <div class="node-stat">
          <i class="fa-solid fa-list-ol"></i>
          {{selectedNode.responses.length}} {{localize "BOBSNPC.DialogueEditor.Choices"}}
        </div>
      {{/if}}

      {{#if (eq selectedNode.type "skill_check")}}
        <div class="node-stats-row">
          <div class="node-stat">
            <i class="fa-solid fa-dice-d20"></i>
            {{selectedNode.skillCheck.skill}}
          </div>
          <div class="node-stat">
            <span class="dc-label">DC</span> {{selectedNode.skillCheck.dc}}
          </div>
        </div>
      {{/if}}

      {{#if (eq selectedNode.type "quest_offer")}}
        <div class="node-stat">
          <i class="fa-solid fa-scroll"></i>
          {{#if selectedNode.questId}}{{selectedNode.questId}}{{else}}{{localize "BOBSNPC.DialogueEditor.NoQuestSelected"}}{{/if}}
        </div>
      {{/if}}

      {{#if (eq selectedNode.type "quest_turnin")}}
        <div class="node-stat">
          <i class="fa-solid fa-check-circle"></i>
          {{#if selectedNode.questId}}{{selectedNode.questId}}{{else}}{{localize "BOBSNPC.DialogueEditor.NoQuestSelected"}}{{/if}}
        </div>
      {{/if}}

      {{#if (eq selectedNode.type "end")}}
        <div class="form-group">
          <label>{{localize "BOBSNPC.DialogueEditor.ClosingText"}}</label>
          <textarea name="node.text" rows="2">{{selectedNode.text}}</textarea>
        </div>
      {{/if}}

      <button type="button" class="edit-full-btn" data-action="editNode">
        <i class="fa-solid fa-cog"></i>
        {{localize "BOBSNPC.DialogueEditor.EditAllProperties"}}
      </button>
    </div>
  </section>
  {{/if}}
</aside>
