{{!-- NPC Config - Factions Tab --}}
<div class="tab-content factions-tab {{theme}}" {{#unless (eq activeTab 'factions')}}hidden{{/unless}}>
  <section class="config-section">
    <h3>{{localize "BOBSNPC.NPCConfig.FactionMemberships"}}</h3>
    <p class="section-hint">{{localize "BOBSNPC.NPCConfig.FactionMembershipsHint"}}</p>

    {{#if factionsDisplay.length}}
      <ul class="factions-list">
        {{#each factionsDisplay}}
          <li class="faction-entry">
            <input type="hidden" name="config.factions.{{this.index}}.factionId" value="{{this.factionId}}" />
            <div class="faction-info">
              <i class="fa-solid {{this.icon}}" style="color: {{this.color}}"></i>
              <span class="faction-name">{{this.name}}</span>
            </div>

            <div class="faction-details">

              {{!-- Rank: dropdown from faction's defined ranks (prestige/standing tier) --}}
              <div class="form-group inline">
                <label>{{localize "BOBSNPC.NPCConfig.Rank"}}</label>
                <select name="config.factions.{{this.index}}.rank">
                  <option value="">— {{localize "BOBSNPC.NPCConfig.NoRank"}} —</option>
                  {{#each this.availableRanks}}
                    <option value="{{this.id}}" {{#if (eq this.id ../rank)}}selected{{/if}}>
                      {{this.name}}
                    </option>
                  {{/each}}
                </select>
              </div>

              {{!-- Role: dropdown from faction's custom roles (functional position) --}}
              <div class="form-group inline">
                <label>{{localize "BOBSNPC.NPCConfig.FactionRole"}}</label>
                {{#if this.availableRoles.length}}
                  <select name="config.factions.{{this.index}}.roleId">
                    <option value="">— {{localize "BOBSNPC.NPCConfig.NoRole"}} —</option>
                    {{#each this.availableRoles}}
                      <option value="{{this.id}}" {{#if (eq this.id ../roleId)}}selected{{/if}}>
                        {{this.name}}
                      </option>
                    {{/each}}
                  </select>
                {{else}}
                  <span class="hint">{{localize "BOBSNPC.NPCConfig.NoRolesDefined"}}</span>
                  <input type="hidden" name="config.factions.{{this.index}}.roleId" value="" />
                {{/if}}
              </div>

            </div>

            <button type="button" class="remove-btn" data-action="removeFaction" data-index="{{this.index}}">
              <i class="fa-solid fa-times"></i>
            </button>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <div class="empty-state">
        <i class="fa-solid fa-flag"></i>
        <p>{{localize "BOBSNPC.NPCConfig.NoFactions"}}</p>
      </div>
    {{/if}}
  </section>

  <section class="config-section">
    <h3>{{localize "BOBSNPC.NPCConfig.AddFaction"}}</h3>

    <div class="add-faction-form">
      <select name="newFaction">
        <option value="">{{localize "BOBSNPC.NPCConfig.SelectFaction"}}</option>
        {{#each availableFactions}}
          <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" class="add-btn" data-action="addFaction">
        <i class="fa-solid fa-plus"></i>
        {{localize "BOBSNPC.NPCConfig.Add"}}
      </button>
    </div>
  </section>
</div>
