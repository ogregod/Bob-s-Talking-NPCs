{{!-- Bank Window Footer - Enhanced with game time and GM controls --}}
<footer class="bank-footer">
  <div class="footer-info">
    {{#if bankHours}}
      <span class="bank-hours" data-tooltip="{{localize 'BOBSNPC.Bank.BankHours'}}">
        <i class="fa-solid fa-clock"></i>
        {{bankHours}}
      </span>
    {{/if}}

    {{#if interestPayoutDate}}
      <span class="interest-payout" data-tooltip="{{localize 'BOBSNPC.Bank.NextInterestPayout'}}">
        <i class="fa-solid fa-calendar-check"></i>
        {{localize "BOBSNPC.Bank.InterestIn"}} {{interestPayoutDate}}
      </span>
    {{/if}}

    {{#if savingsRateFormatted}}
      <span class="rate-display" data-tooltip="{{localize 'BOBSNPC.Bank.SavingsInterestRate'}}">
        <i class="fa-solid fa-percentage"></i>
        {{savingsRateFormatted}} {{localize "BOBSNPC.Bank.Interest"}}
      </span>
    {{/if}}
  </div>

  <div class="footer-actions">
    {{#unless hasAccounts}}
      <button type="button" class="bank-btn primary" data-action="openAccount" data-account-type="personal">
        <i class="fa-solid fa-plus-circle"></i>
        {{localize "BOBSNPC.Bank.OpenAccount"}}
      </button>
    {{/unless}}

    <button type="button" class="bank-btn secondary" data-action="closeBank">
      <i class="fa-solid fa-door-open"></i>
      {{localize "BOBSNPC.Bank.Leave"}}
    </button>
  </div>

  {{#if isGM}}
    <div class="gm-controls">
      <span class="gm-label">GM</span>
      <button type="button" class="gm-btn" data-action="editBank" data-tooltip="{{localize 'BOBSNPC.Bank.EditBank'}}">
        <i class="fa-solid fa-edit"></i>
      </button>
      <button type="button" class="gm-btn" data-action="processInterest" data-tooltip="{{localize 'BOBSNPC.Bank.ProcessInterest'}}">
        <i class="fa-solid fa-percentage"></i>
      </button>
    </div>
  {{/if}}
</footer>
