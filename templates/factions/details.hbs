{{!-- Faction Cards Area --}}
<div class="faction-cards-area {{theme}}">
  {{#if hasFactions}}
    {{#each factionCards}}
      <div class="faction-card {{this.standingClass}} {{#if this.isCollapsed}}collapsed{{/if}}"
           style="border-left: 4px solid {{this.color}}">

        {{!-- Card Header (always visible) --}}
        <div class="faction-card-header">

          <div class="faction-emblem" style="background-color: {{this.color}}20; color: {{this.color}}; border: 2px solid {{this.color}}40">
            <i class="fa-solid {{this.icon}}"></i>
          </div>

          <div class="faction-card-title">
            <h3 class="faction-name">{{this.name}}</h3>
            {{#if this.shortDescription}}
              <p class="faction-short-desc">{{this.shortDescription}}</p>
            {{/if}}
          </div>

          <div class="faction-card-meta">
            <span class="standing-badge {{this.standingClass}}">{{this.levelLabel}}</span>
            <span class="rep-number">{{this.reputation}} rep</span>
            {{#if this.currentRank}}
              <span class="rank-badge" {{#if this.currentRank.color}}style="color: {{this.currentRank.color}}"{{/if}}>
                <i class="fa-solid {{this.currentRank.icon}}"></i>
                {{this.currentRank.name}}
              </span>
            {{/if}}
          </div>

          {{!-- Mini rep bar (always visible) --}}
          <div class="rep-minibar-wrapper">
            <div class="rep-minibar">
              <div class="rep-minibar-fill {{this.standingClass}}" style="width: {{this.progress.percent}}%"></div>
            </div>
          </div>

          <button type="button" class="collapse-btn" data-action="toggleCollapse" data-faction-id="{{this.id}}"
                  title="{{#if this.isCollapsed}}Expand{{else}}Collapse{{/if}}">
            <i class="fa-solid {{#if this.isCollapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i>
          </button>
        </div>

        {{!-- Card Body (visible when expanded) --}}
        {{#unless this.isCollapsed}}
          <div class="faction-card-body">

            {{!-- Reputation Bar --}}
            <div class="rep-section">
              <div class="rep-bar-track">
                <div class="rep-bar-fill {{this.standingClass}}" style="width: {{this.progress.percent}}%"></div>
              </div>
              <div class="rep-labels">
                <span class="rep-min">{{this.progress.min}}</span>
                <span class="rep-current-label">{{this.reputation}} rep</span>
                <span class="rep-max">{{this.progress.max}}</span>
              </div>
              {{#if this.nextLevel}}
                <p class="rep-next-label">
                  <i class="fa-solid fa-arrow-up"></i>
                  {{this.nextLevelLabel}} in {{this.reputationNeeded}} rep
                </p>
              {{else}}
                <p class="rep-next-label max-rep">
                  <i class="fa-solid fa-star"></i>
                  Max Reputation
                </p>
              {{/if}}
            </div>

            {{!-- Description --}}
            {{#if this.description}}
              <div class="faction-desc-section">
                <p class="faction-description">{{{this.description}}}</p>
              </div>
            {{/if}}

            {{!-- Headquarters --}}
            {{#if this.headquarters.sceneId}}
              <div class="card-section">
                <span class="section-label"><i class="fa-solid fa-map-marker-alt"></i> Headquarters</span>
                <span class="hq-scene">{{this.headquarters.sceneId}}</span>
              </div>
            {{/if}}

            {{!-- Ranks Track --}}
            {{#if this.ranks.length}}
              <div class="card-section">
                <p class="section-label"><i class="fa-solid fa-medal"></i> Ranks</p>
                <div class="ranks-track">
                  {{#each this.ranks}}
                    <div class="rank-pip
                                {{#if this.isCurrentRank}}current{{/if}}
                                {{#if this.isAchieved}}achieved{{/if}}
                                {{#unless this.requirementsMet}}locked{{/unless}}"
                         title="{{this.name}} — {{this.requiredReputation}} rep required">
                      <div class="rank-dot" {{#if this.isAchieved}}style="background-color: {{this.color}}; border-color: {{this.color}}"{{/if}}>
                        <i class="fa-solid {{this.icon}}"></i>
                      </div>
                      <span class="rank-pip-name">{{this.name}}</span>
                    </div>
                  {{/each}}
                </div>
              </div>
            {{/if}}

            {{!-- Roles (Functional Positions) --}}
            {{#if this.roles.length}}
              <div class="card-section">
                <p class="section-label"><i class="fa-solid fa-user-tie"></i> Roles</p>
                <div class="roles-row">
                  {{#each this.roles}}
                    <span class="role-tag {{#if this.isLeader}}is-leader{{/if}}"
                          {{#if this.color}}style="border-color: {{this.color}}; color: {{this.color}}"{{/if}}>
                      {{#if this.icon}}<i class="fa-solid {{this.icon}}"></i> {{/if}}
                      {{this.name}}
                      {{#if this.isLeader}}<i class="fa-solid fa-crown" style="font-size: 0.7em; opacity: 0.8; margin-left: 3px;"></i>{{/if}}
                    </span>
                  {{/each}}
                </div>
              </div>
            {{/if}}

            {{!-- Members --}}
            {{#if this.hasMembers}}
              <div class="card-section">
                <p class="section-label"><i class="fa-solid fa-users"></i> Members</p>
                <div class="members-row">
                  {{#each this.members}}
                    <span class="member-chip {{#if this.isLeader}}is-leader{{/if}}"
                          title="{{this.name}}{{#if this.roleName}} — {{this.roleName}}{{/if}}{{#if this.rankName}} ({{this.rankName}}){{/if}}">
                      {{#if this.img}}
                        <img src="{{this.img}}" class="member-avatar" alt="{{this.name}}" />
                      {{/if}}
                      <span class="member-chip-name">
                        {{#if this.isLeader}}<i class="fa-solid fa-crown" style="color: gold; font-size: 0.7em;"></i> {{/if}}
                        {{this.name}}
                      </span>
                      {{#if this.roleName}}
                        <span class="member-role-tag" {{#if this.roleColor}}style="color: {{this.roleColor}}"{{/if}}>
                          {{#if this.roleIcon}}<i class="fa-solid {{this.roleIcon}}"></i> {{/if}}
                          {{this.roleName}}
                        </span>
                      {{/if}}
                      {{#if this.rankName}}
                        <span class="member-rank-tag" {{#if this.rankColor}}style="color: {{this.rankColor}}"{{/if}}>
                          {{this.rankName}}
                        </span>
                      {{/if}}
                    </span>
                  {{/each}}
                  {{#if this.moreMembers}}
                    <span class="more-members-chip">+{{this.moreMembers}} more</span>
                  {{/if}}
                </div>
              </div>
            {{/if}}

            {{!-- Faction Relations --}}
            {{#if this.hasRelations}}
              <div class="card-section">
                <p class="section-label"><i class="fa-solid fa-handshake"></i> Relations</p>
                <div class="relations-row">
                  {{#each this.relations}}
                    <span class="relation-chip {{this.typeClass}}">
                      <i class="fa-solid {{this.factionIcon}}" style="color: {{this.factionColor}}"></i>
                      {{this.factionName}}
                      <span class="relation-type-label">{{this.typeLabel}}</span>
                      {{#if this.effect}}
                        <span class="relation-effect">{{#if (gt this.effect 0)}}+{{/if}}{{this.effect}}%</span>
                      {{/if}}
                    </span>
                  {{/each}}
                </div>
              </div>
            {{/if}}

            {{!-- Benefits --}}
            {{#if this.benefits.length}}
              <div class="card-section card-section-benefits">
                <p class="section-label"><i class="fa-solid fa-star"></i> Benefits</p>
                <ul class="perk-list">
                  {{#each this.benefits}}
                    <li class="perk-entry benefit {{this.type}}">
                      <i class="fa-solid {{this.icon}}"></i>
                      <span>{{this.description}}</span>
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{/if}}

            {{!-- Penalties --}}
            {{#if this.penalties.length}}
              <div class="card-section card-section-penalties">
                <p class="section-label"><i class="fa-solid fa-ban"></i> Penalties</p>
                <ul class="perk-list">
                  {{#each this.penalties}}
                    <li class="perk-entry penalty">
                      <i class="fa-solid {{this.icon}}"></i>
                      <span>{{this.description}}</span>
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{/if}}

            {{!-- Card Actions --}}
            <div class="card-actions">
              {{#if ../isGM}}
                <button type="button" class="card-action-btn edit-btn" data-action="editFaction" data-faction-id="{{this.id}}">
                  <i class="fa-solid fa-edit"></i>
                  Edit Faction
                </button>
                <button type="button" class="card-action-btn rep-btn" data-action="modifyReputation" data-faction-id="{{this.id}}">
                  <i class="fa-solid fa-sliders"></i>
                  Modify Rep
                </button>
              {{/if}}
            </div>

          </div>
        {{/unless}}
      </div>
    {{/each}}

  {{else}}
    <div class="no-factions-state">
      <i class="fa-solid fa-flag"></i>
      <p>{{localize "BOBSNPC.Factions.NoFactions"}}</p>
      {{#if isGM}}
        <button type="button" class="create-faction-btn" data-action="createFaction">
          <i class="fa-solid fa-plus"></i>
          {{localize "BOBSNPC.Factions.Create"}}
        </button>
      {{/if}}
    </div>
  {{/if}}
</div>
